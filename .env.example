PORT=3000
NODE_ENV=development
# Optional: override Node.js DNS resolvers if Atlas SRV queries fail.
# Use DNS servers approved for your network; separate multiple IPs with commas.
# MONGODB_DNS_SERVERS=192.168.1.1
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/veerbhadra?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=replace-with-a-strong-unique-password
